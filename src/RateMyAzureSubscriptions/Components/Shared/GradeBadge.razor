<span class="grade-badge @(Large ? "lg" : "") @(Small ? "sm" : "")" style="background:@AuditRatingService.ColorForGrade(Grade);" title="@Title">@Grade</span>

@code {
    /// <summary>"A" to "F", or "–" when not assessed.</summary>
    [Parameter] public string Grade { get; set; } = "F";
    [Parameter] public bool Large { get; set; }
    [Parameter] public bool Small { get; set; }

    private string Title => $"Grade {Grade} — {AuditRatingService.LabelForGrade(Grade)}";
}
