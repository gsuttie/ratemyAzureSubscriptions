@inject NavigationManager Nav

<ol class="stepbar" aria-label="Steps">
    @for (var i = 0; i < Steps.Length; i++)
    {
        var (key, label, hint) = Steps[i];
        var n = i + 1;
        var state = key == Current ? "active" : Reachable(key) ? (Index(key) < Index(Current) ? "done" : "ready") : "locked";
        <li class="step @state">
            @if (state is "done" or "ready")
            {
                <a href="/audit/@key" title="@hint"><span class="step-num">@(state == "done" ? "✓" : n.ToString())</span><span class="step-label">@label</span></a>
            }
            else
            {
                <span title="@(state == "locked" ? "Run a scan first" : hint)"><span class="step-num">@n</span><span class="step-label">@label</span></span>
            }
        </li>
        @if (i < Steps.Length - 1)
        {
            <li class="step-line @(Index(key) < Index(Current) ? "done" : "")" aria-hidden="true"></li>
        }
    }
</ol>

@code {
    [Parameter] public string Current { get; set; } = "scope";
    [Parameter] public bool HasScan { get; set; }

    private static readonly (string Key, string Label, string Hint)[] Steps =
    [
        ("scope", "Scope", "Choose the subscriptions to scan"),
        ("grades", "Grades", "A-F grade per area, findings and inventory"),
        ("plan", "Improvement plan", "Prioritised actions with effort and fix scripts"),
    ];

    private static int Index(string key) => Array.FindIndex(Steps, s => s.Key == key);

    private bool Reachable(string key) => key == "scope" || HasScan;
}
